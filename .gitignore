# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Persistent database and backups must never be checked in
/data/
/*.sqlite
/*.sqlite-*
*.sqlite3
*.db
*.db-shm
*.db-wal
*.db-journal

# Optional local native skill discovery aliases; canonical skills are in .agents/skills
/.claude/skills
/.cursor/skills
/.github/skills
/.gemini/skills

# Local development SQLite and generated QA evidence
/.local/
/qa-artifacts/
